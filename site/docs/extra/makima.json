{
  "name": "makima",
  "type": "dark",
  "colors": {
    "editor.background": "#120c0c",
    "editor.foreground": "#e9dede"
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7a5c5c", "fontStyle": "" }
    },
    {
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#ffb08a" }
    },
    {
      "scope": ["string.unquoted"],
      "settings": { "foreground": "#e9dede" }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "constant.character.escape"
      ],
      "settings": { "foreground": "#e8b06a" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ff4545", "fontStyle": "" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ff4545" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.command",
        "meta.function-call entity.name",
        "support.function.builtin"
      ],
      "settings": { "foreground": "#ff8080", "fontStyle": "" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "scope": [
        "entity.name.tag",
        "support.type.property-name",
        "variable.other.member",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": { "foreground": "#ff4545" }
    },
    {
      "scope": ["tag.attribute"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "scope": ["variable"],
      "settings": { "foreground": "#e9dede" }
    },
    {
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#e8b06a" }
    },
    {
      "scope": ["punctuation"],
      "settings": { "foreground": "#e9dede" }
    },
    {
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#ff8080" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e03030" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#ff8080" }
    }
  ]
}
